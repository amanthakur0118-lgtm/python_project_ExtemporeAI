# ExtemporeAI Deployment Configuration
SECRET_KEY=your-random-secret-key-here

# MySQL Configuration (Leave blank or localhost for local SQLite fallback)
DB_HOST=your-cloud-mysql-host.aivencloud.com
DB_PORT=3306
DB_USER=avnadmin
DB_PASSWORD=your-mysql-password
DB_NAME=defaultdb
ALLOW_SQLITE_FALLBACK=true

# Google Gemini API Key (Optional; for advanced LLM reasoning)
# Get free key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
